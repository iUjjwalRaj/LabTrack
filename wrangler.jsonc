{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labtrack-equipment-system",
  "main": "index.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat_v2",
    "no_handle_cross_request_promise_resolution"
  ],


  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "alias": {
    "mongoose": "mongoose/lib/index.js"
  }
}
